<Window x:Class="BiliDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BiliDesktop" Title="BiliDesktop" Height="620" Width="900" MinHeight="520" MinWidth="780">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
      <Button x:Name="SettingsButton" DockPanel.Dock="Right" Padding="14,5" Margin="8,0,0,0" Click="Settings_Click"/>
      <Button x:Name="DownloadQueueButton" DockPanel.Dock="Right" Padding="14,5" Margin="8,0,0,0" Click="DownloadQueue_Click"/>
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="BiliDesktop"/>
    </DockPanel>
    <WrapPanel x:Name="Navigation" Grid.Row="1" Margin="0,0,0,12">
      <Button Content="{DynamicResource Loc_44CE7AE909BBB28B}" Padding="14,5" Margin="0,0,8,4" Click="Search_Click"/>
      <Button Content="{DynamicResource Loc_B15BEB60C36A77B6}" Padding="14,5" Margin="0,0,8,4" Click="Uploader_Click"/>
      <Button x:Name="FavoritesEntry" Content="{DynamicResource Loc_796D20E915884195}" Padding="14,5" Margin="0,0,8,4" Click="Favorites_Click"/>
      <Button Content="{DynamicResource Loc_1F7F0DB90F932DFA}" Padding="14,5" Margin="0,0,8,4" Click="Keywords_Click"/>
      <Button x:Name="LiveButton" Padding="14,5" Margin="0,0,8,4" Click="Live_Click"/>
    </WrapPanel>
    <DockPanel x:Name="ParseBar" Grid.Row="2" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="{DynamicResource Loc_FBFF7B5046D951DC}" Padding="18,6" Margin="8,0,0,0" Click="Parse_Click"/>
      <TextBox x:Name="Input" Padding="8" ToolTip="{DynamicResource Loc_490558CE73D41ABD}" KeyDown="Input_KeyDown"/>
    </DockPanel>
    <Expander x:Name="AccountExpander" Grid.Row="3" Margin="0,0,0,12">
      <Expander.Header><WrapPanel><TextBlock x:Name="AccountLabel" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBlock x:Name="LoginStatus" Text="{DynamicResource Loc_FCFA3F97FE7BDDD5}" TextWrapping="Wrap"/></WrapPanel></Expander.Header>
      <StackPanel Margin="12,10,0,0"><TextBlock Text="{DynamicResource Loc_1B8B8902738F5D1C}" Margin="0,0,0,6"/><PasswordBox x:Name="CookieText" Padding="6"/><CheckBox x:Name="RememberLogin" Content="{DynamicResource Loc_35586D94629E8EF6}" IsChecked="True" Margin="0,8,0,0"/><WrapPanel Margin="0,10,0,0"><Button Content="{DynamicResource Loc_E218AE0B8446770C}" Padding="12,5" Click="Login_Click"/><Button Content="{DynamicResource Loc_378EACA774BB9551}" Padding="12,5" Margin="8,0,0,0" Click="Qr_Click"/><Button Content="{DynamicResource Loc_3AB8CC15939F3B5C}" Padding="12,5" Margin="8,0,0,0" Click="Logout_Click"/></WrapPanel></StackPanel>
    </Expander>
    <Grid Grid.Row="4">
      <TextBlock x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
      <ScrollViewer x:Name="ResultsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock x:Name="TitleText" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <DockPanel Margin="0,0,0,12"><TextBlock Text="{DynamicResource Loc_0A4DD4A2736347F3}" VerticalAlignment="Center" Width="110"/><ComboBox x:Name="Pages" DisplayMemberPath="Label" SelectionChanged="Pages_SelectionChanged" MinWidth="350" HorizontalAlignment="Left"/></DockPanel>
          <WrapPanel Margin="0,0,0,8"><TextBlock x:Name="QualityLabel" VerticalAlignment="Center" Width="110"/><ComboBox x:Name="Qualities" DisplayMemberPath="Label" SelectionChanged="Qualities_Changed" Width="155"/><TextBlock x:Name="CodecLabel" VerticalAlignment="Center" Margin="12,0,8,0"/><ComboBox x:Name="Codecs" DisplayMemberPath="Label" SelectionChanged="Codecs_Changed" Width="220"/><ComboBox x:Name="Streams" Visibility="Collapsed" SelectionChanged="Options_Changed"/></WrapPanel>
          <DockPanel Margin="0,0,0,8"><TextBlock Text="{DynamicResource Loc_3ED5457CF859D535}" VerticalAlignment="Center" Width="110"/><ComboBox x:Name="AudioStreams" DisplayMemberPath="Label" SelectionChanged="Options_Changed" MinWidth="380" HorizontalAlignment="Left"/></DockPanel>
          <TextBlock x:Name="SelectedSize" Margin="110,0,0,8"/>
          <DockPanel Margin="0,0,0,8"><TextBlock Text="{DynamicResource Loc_72552773CB5DCF1C}" VerticalAlignment="Center" Width="110"/><ComboBox x:Name="VideoProcess" Width="310" HorizontalAlignment="Left" SelectedIndex="0"><ComboBoxItem Content="{DynamicResource Loc_7BC658DC4E1198FF}"/><ComboBoxItem Content="{DynamicResource Loc_B7C7D9EAF452273D}"/><ComboBoxItem Content="{DynamicResource Loc_9715EC4504ADBE04}"/><ComboBoxItem Content="{DynamicResource Loc_A45BBE3D78E9EE07}"/><ComboBoxItem Content="{DynamicResource Loc_6E0BDA8BA5F41DE8}"/></ComboBox></DockPanel>
          <WrapPanel Margin="0,0,0,8"><TextBlock Text="{DynamicResource Loc_7A688306423BEC17}" VerticalAlignment="Center" Width="110"/><ComboBox x:Name="DownloadMode" Width="180" SelectedIndex="0" SelectionChanged="Options_Changed"><ComboBoxItem Content="{DynamicResource Loc_B89B44A5346D5FE5}"/><ComboBoxItem Content="{DynamicResource Loc_DC5527002044AA25}"/><ComboBoxItem Content="{DynamicResource Loc_4EEF33B40874356F}"/><ComboBoxItem Content="{DynamicResource Loc_CCBB5EE62B1A5992}"/></ComboBox></WrapPanel>
          <local:AudioOptionsControl x:Name="AudioOptions" Visibility="Collapsed" Margin="0,0,0,10"/>
          <WrapPanel><Button x:Name="DownloadButton" IsEnabled="False" Padding="15,6" Margin="0,0,8,4" Click="Download_Click"/><Button x:Name="BatchButton" Content="{DynamicResource Loc_E2C50DA7658828CE}" IsEnabled="False" Padding="12,6" Margin="0,0,8,4" Click="Batch_Click"/><Button x:Name="CollectionButton" Content="{DynamicResource Loc_FF61FF4F37775815}" IsEnabled="False" Padding="12,6" Margin="0,0,8,4" Click="Collection_Click"/></WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <DockPanel Grid.Row="5" Margin="0,12,0,0"><Button x:Name="AboutButton" DockPanel.Dock="Right" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Bottom" Click="About_Click"/><Button x:Name="UpdateAvailable" DockPanel.Dock="Right" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Bottom" Visibility="Collapsed" Click="UpdateAvailable_Click"/><TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
  </Grid>
</Window>
