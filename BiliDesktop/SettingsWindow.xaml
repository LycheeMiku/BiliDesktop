<Window x:Class="BiliDesktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="设置" Width="720" Height="660" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" KeyDown="Window_KeyDown">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <GroupBox x:Name="GeneralGroup" Margin="0,0,0,12"><StackPanel Margin="12">
          <DockPanel Margin="0,0,0,10"><TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" Width="125"/><ComboBox x:Name="LanguageSelector" Width="150" HorizontalAlignment="Left"><ComboBoxItem Content="简体中文"/><ComboBoxItem Content="繁體中文"/><ComboBoxItem Content="English"/></ComboBox></DockPanel>
          <WrapPanel><CheckBox x:Name="StartAtLogin" VerticalAlignment="Center" Margin="0,0,24,8"/><CheckBox x:Name="AllowBackground" VerticalAlignment="Center" Margin="0,0,0,8"/></WrapPanel>
        </StackPanel></GroupBox>
        <GroupBox x:Name="DownloadGroup" Margin="0,0,0,12"><StackPanel Margin="12">
          <CheckBox x:Name="UseDefaultVideoDirectory" Margin="0,0,0,8" Checked="UseDefaultDirectory_Changed" Unchecked="UseDefaultDirectory_Changed"/>
          <DockPanel Margin="0,0,0,12"><Button x:Name="DownloadDirectoryButton" DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0" Click="DownloadDirectory_Click"/><TextBox x:Name="DownloadDirectoryBox" IsReadOnly="True" Padding="5"/></DockPanel>
          <WrapPanel Margin="0,0,0,10"><TextBlock x:Name="ConnectionsLabel" VerticalAlignment="Center"/><ComboBox x:Name="Connections" IsEditable="True" Width="75" Margin="8,0,18,0"><ComboBoxItem Content="1"/><ComboBoxItem Content="4"/><ComboBoxItem Content="8"/><ComboBoxItem Content="16"/><ComboBoxItem Content="32"/><ComboBoxItem Content="64"/></ComboBox><TextBlock x:Name="CacheLabel" VerticalAlignment="Center"/><ComboBox x:Name="CacheSize" IsEditable="True" Width="75" Margin="8,0,0,0"><ComboBoxItem Content="0"/><ComboBoxItem Content="16"/><ComboBoxItem Content="64"/><ComboBoxItem Content="128"/><ComboBoxItem Content="256"/><ComboBoxItem Content="512"/></ComboBox></WrapPanel>
          <WrapPanel><TextBlock x:Name="MaxTasksLabel" VerticalAlignment="Center"/><TextBox x:Name="MaxTasks" Width="70" Margin="8,0,0,0" Padding="4"/><CheckBox x:Name="UnlimitedTasks" Margin="12,0,0,0" VerticalAlignment="Center" Checked="UnlimitedTasks_Changed" Unchecked="UnlimitedTasks_Changed"/></WrapPanel>
        </StackPanel></GroupBox>
        <GroupBox Header="User-Agent"><StackPanel Margin="12">
          <DockPanel Margin="0,0,0,8"><TextBlock x:Name="UserAgentPresetLabel" VerticalAlignment="Center" Width="125"/><ComboBox x:Name="UserAgentPresetBox" MinWidth="250" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectionChanged="UserAgentPreset_Changed"/></DockPanel>
          <TextBox x:Name="UserAgentBox" Padding="5" TextChanged="UserAgentText_Changed"/>
        </StackPanel></GroupBox>
      </StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="1" x:Name="Status" Margin="0,10,0,0" TextWrapping="Wrap"/>
    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0"><Button x:Name="ConfirmButton" Padding="16,5" Margin="0,0,8,0" Click="Confirm_Click"/><Button x:Name="ApplyButton" Padding="16,5" Margin="0,0,8,0" Click="Apply_Click"/><Button x:Name="CancelButton" Padding="16,5" Click="Cancel_Click"/></WrapPanel>
  </Grid>
</Window>
