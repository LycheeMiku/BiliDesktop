<Window x:Class="BiliDesktop.DownloadQueueWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="1100" Height="580" MinWidth="800" MinHeight="400" WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DataGrid x:Name="Tasks" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTemplateColumn Width="45"><DataGridTemplateColumn.Header><CheckBox x:Name="SelectAll" Click="SelectAll_Click" HorizontalAlignment="Center"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="Check_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn x:Name="NameColumn" Binding="{Binding Title}" Width="2*"/>
        <DataGridTextColumn x:Name="StatusColumn" Binding="{Binding StateText}" Width="85"/>
        <DataGridTemplateColumn x:Name="ProgressColumn" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><ProgressBar Value="{Binding Percent, Mode=OneWay}" Minimum="0" Maximum="100" Height="14"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn x:Name="BytesColumn" Binding="{Binding ProgressText}" Width="170"/>
        <DataGridTextColumn x:Name="SpeedColumn" Binding="{Binding Speed}" Width="100"/>
        <DataGridTextColumn x:Name="ConnectionsColumn" Binding="{Binding Connections}" Width="65"/>
        <DataGridTextColumn x:Name="EtaColumn" Binding="{Binding Eta}" Width="85"/>
      </DataGrid.Columns>
    </DataGrid>
    <WrapPanel Grid.Row="1" Margin="0,12,0,0"><Button x:Name="PauseButton" Padding="10,5" Margin="0,0,8,0" Click="Pause_Click"/><Button x:Name="ResumeButton" Padding="10,5" Margin="0,0,8,0" Click="Resume_Click"/><Button x:Name="RetryButton" Padding="10,5" Margin="0,0,8,0" Click="Retry_Click"/><Button x:Name="CancelButton" Padding="10,5" Margin="0,0,8,0" Click="Cancel_Click"/><Button x:Name="OpenButton" Padding="10,5" Margin="0,0,8,0" Click="Open_Click"/><Button x:Name="FolderButton" Padding="10,5" Margin="0,0,8,0" Click="Folder_Click"/><Button x:Name="RemoveButton" Padding="10,5" Margin="0,0,8,0" Click="Remove_Click"/><Button x:Name="DeleteButton" Padding="10,5" Click="Delete_Click"/></WrapPanel>
    <TextBlock Grid.Row="2" x:Name="Status" Margin="0,10,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
