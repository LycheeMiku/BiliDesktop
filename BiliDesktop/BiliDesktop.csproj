<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.3.0-beta3</Version>
    <InformationalVersion>beta3</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="..\BililiveRecorder\BililiveRecorder.Core\BililiveRecorder.Core.csproj" />
    <Content Include="vendor\aria2\aria2c.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="vendor\aria2\COPYING" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="vendor\aria2\LICENSE.OpenSSL" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="vendor\licenses\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.11" />
  </ItemGroup>

</Project>
